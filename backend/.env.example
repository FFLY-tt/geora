# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored; this file is the template committed to the repo.

# --------------------------------------------------------------------------
# Perplexity API key
# Sign up / generate a key at: https://www.perplexity.ai/settings/api
# Used by: engines/citation_engine.py
# Purpose: queries the Perplexity "sonar" models to find out whether the
# target company/domain is cited as a source when real users ask questions
# related to its industry (citation visibility check).
# --------------------------------------------------------------------------
PERPLEXITY_API_KEY=your-perplexity-api-key

# --------------------------------------------------------------------------
# DeepSeek API key
# Sign up / generate a key at: https://platform.deepseek.com/api_keys
# Used by: engines/evidence_engine.py
# Purpose: sends the scraped homepage text to a DeepSeek chat model to judge
# whether the page content contains concrete evidence (stats, citations,
# clear feature descriptions) versus vague marketing language.
# --------------------------------------------------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key

# --------------------------------------------------------------------------
# Contact email
# Used by: backend/scripts/batch_diagnose.py
# Purpose: included in the User-Agent header the batch script sends for its
# own direct requests (robots.txt checks, redirect detection), so a site
# operator who wants to block or ask about this traffic has a way to reach
# someone. Optional: the script still runs without it, just without an
# email in its User-Agent.
# --------------------------------------------------------------------------
CONTACT_EMAIL=you@example.com
